{
	"name": "kapsel",
	"version": "1.2.1",
	"private": true,
	"description": "Windows application installer and updater built with PowerShell Windows Forms.",
	"scripts": {
		"start": "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File ./scripts/Start-Kapsel.ps1",
		"dev": "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File ./scripts/Start-Kapsel.ps1",
		"app": "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File ./scripts/Start-Kapsel.ps1",
		"help": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/Start-Kapsel.ps1 -Command help",
		"version": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/Start-Kapsel.ps1 -Command version",
		"validate": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/Validate-PowerShell.ps1",
		"test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"Import-Module Pester -RequiredVersion 4.10.1; Invoke-Pester ./tests\"",
		"test:ui": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/Test-UiSmoke.ps1",
		"docs:catalog": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/Generate-CatalogMarkdown.ps1",
		"docs:catalog:check": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/Generate-CatalogMarkdown.ps1 -Check",
		"build": "npm run build:check",
		"build:check": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./build.ps1 -SkipExecutable",
		"build:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./build.ps1 -InstallBuildDependency",
		"release": "npm run validate && npm test && npm run build:release",
		"clean": "npm run clean:releases",
		"clean:releases": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/Clean-Releases.ps1"
	},
	"keywords": [
		"windows",
		"powershell",
		"winget",
		"chocolatey",
		"installer"
	],
	"author": "Federico Tomassini",
	"engines": {
		"node": ">=24"
	}
}
